# --- Nguồn dữ liệu -----------------------------------------------------------
# Cách 1: đọc file local (OneDrive sync / tải tay). Nếu đặt biến này thì bỏ qua Graph.
SOURCE_FILE="C:/path/to/Bao cao Thầu KNK.xlsx"

# Cách 2: tải qua Microsoft Graph từ link chia sẻ SharePoint/OneDrive.
SHAREPOINT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Có secret => app-only (cần admin cấp Files.Read.All / Sites.Read.All loại Application).
# Để trống => đăng nhập bằng device code với tài khoản của bạn (quyền delegated Files.Read.All).
AZURE_CLIENT_SECRET=

# --- Làm sạch -----------------------------------------------------------------
# Danh sách sheet cần lấy, cách nhau bởi dấu phẩy. Để trống = sheet đầu tiên.
SHEETS=So lieu 2025,So lieu 2026
# Danh mục sản phẩm chuẩn: lấy BU theo nhóm sản phẩm (sheet "Danh mục Nhóm sản phẩm").
PRODUCT_CATALOG_FILE="C:/path/to/Danh mục Sản phẩm.xlsx"
# Dòng tiêu đề (đánh số từ 1 như trong Excel). Để trống = tự dò.
HEADER_ROW=

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dùng secret key (sb_secret_...) hoặc service_role key. KHÔNG dùng key này ở frontend.
SUPABASE_SECRET_KEY=
